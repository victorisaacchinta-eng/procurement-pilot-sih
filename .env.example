# Copy to backend/.env for local runs. Never commit the real .env.

# Reasoning layer (any OpenAI-compatible chat-completions API).
# Leave LLM_API_KEY empty to run deterministic-only; every check still works.
# Production uses Sarvam's sarvam-105b (Indian model). Local: point at Ollama or vLLM instead.
LLM_BASE_URL=https://api.sarvam.ai/v1
LLM_MODEL=sarvam-105b
LLM_API_KEY=
LLM_REASONING_EFFORT=low
LLM_TIMEOUT=25

# Auth. Set a long random JWT_SECRET anywhere real. DEMO_USERS format: user:password:role,...
JWT_SECRET=
JWT_TTL_SECONDS=28800
# DEMO_USERS=officer1:officer123:officer,approver1:approver123:senior_approver,admin1:admin123:admin

# Data protection: evaluations older than this are anonymised.
RETENTION_DAYS=180

# Registry: set a GST data provider key to switch from simulated to live (live call not wired yet).
GST_API_KEY=

# CORS for a split deploy (frontend on another origin). "*" is fine for the demo.
CORS_ORIGINS=*
